{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "petshop-dev": {
        "type": "local",
        "command": [
          "tools/petshop_dev_mcp/.venv/Scripts/python.exe",
          "tools/petshop_dev_mcp/server.py"
        ],
        "cwd": ".",
        "environment": {
          "PETSHOP_ROOT": "."
        }
      },
      "dart": {
        "type": "local",
        "command": [
          "C:\\src\\flutter\\bin\\cache\\dart-sdk\\bin\\dart.exe",
          "mcp-server"
        ],
        "cwd": ".",
        "environment": {
          "PATH": "C:\\src\\flutter\\bin;{env:PATH}"
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "playwright": {
        "type": "local",
        "command": ["cmd", "/c", "npx", "-y", "@playwright/mcp@latest"]
      },
      "supabase": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@supabase/mcp-server-supabase@latest",
          "--read-only",
          "--project-ref={env:SUPABASE_PROJECT_REF}"
        ],
        "environment": {
          "SUPABASE_ACCESS_TOKEN": "{env:SUPABASE_ACCESS_TOKEN}"
        },
        "disabled": false
      }
    }
  }
}
