{
  "mcpServers": {
    "dart": {
      "command": "dart",
      "args": ["mcp-server"]
    },
    "context7": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@upstash/context7-mcp"]
    },
    "supabase": {
      "command": "cmd",
      "args": [
        "/c", "npx", "-y", "@supabase/mcp-server-supabase@latest",
        "--read-only",
        "--project-ref=rutsepsoxwmdpwfnldjq"
      ]
    },
    "playwright": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@latest"]
    },
    "petshop-dev": {
      "command": "tools/petshop_dev_mcp/.venv/Scripts/python.exe",
      "args": ["tools/petshop_dev_mcp/server.py"]
    }
  }
}
